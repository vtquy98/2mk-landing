---
// Dark rounded call-to-action card over the faded "2nd Market" wordmark (/, /viager: simulators; /a-propos: listings).
import Button from './Button.astro';

interface Props {
  title: string;
  text: string;
  href: string;
  label: string; // button text
  padded?: boolean; // section padding above/below (false when the page already spaces it)
}
const { title, text, href, label, padded = true } = Astro.props;
---

<section class="cta gutter">
  <div class:list={['container', padded && 'section']}>
    <div class="cta__box" data-reveal>
      <h2 class="h2" data-reveal>{title}</h2>
      <p class="text-medium" data-reveal>{text}</p>
      <Button href={href}>{label}</Button>
      <img class="cta__mark" src="/assets/67443b2e9369c2292c34f558_2nd-Market.svg" alt="" width="799" height="125" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<script>
  import './reveal';
</script>

<style>
  .cta__box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--size-1);
    align-items: center;
    width: 80%;
    margin-inline: auto;
    padding: 6rem;
    overflow: clip;
    border-radius: var(--radius-large);
    background: var(--color-bg-medium);
    color: var(--color-text-light);
    text-align: center;
  }
  .cta__box > :not(img) { position: relative; z-index: 1; }
  .cta__box h2, .cta__box p { width: 90%; margin: 0; }
  .cta__mark { position: absolute; inset: auto 0 0; width: 100%; height: auto; }
  @media (max-width: 991px) { .cta__box { width: 100%; padding: 4rem; } }
  @media (max-width: 767px) { .cta__box { padding: var(--size-2); } }
  @media (max-width: 479px) { .cta__box { padding: var(--size-1); } }
</style>
