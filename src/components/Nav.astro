---
import { locales, localeList, PRODUCT, t } from '../i18n/config';
import { blogPath, homePath } from '../lib/routes';

interface Props { lang: string; alternates: Record<string, string> }
const { lang, alternates } = Astro.props;
const tx = t(lang).nav;
const home = homePath(lang);
---

<a class="skip" href="#main">{tx.skip}</a>
<header class="nav">
  <div class="container nav__inner">
    <a class="nav__logo" href={home}>{PRODUCT.name}</a>
    <nav class="nav__links">
      <a href={`${home}#features`}>{tx.features}</a>
      <a href={`${home}#faq`}>{tx.faq}</a>
      <a href={blogPath(lang)}>{tx.blog}</a>
      {localeList.length > 1 && (
        <details class="nav__lang">
          <summary aria-label={tx.language}>{locales[lang].code.toUpperCase()}</summary>
          <ul>
            {localeList.map(l => (
              <li><a href={alternates[l.code] ?? homePath(l.code)} hreflang={l.hreflang} lang={l.htmlLang}>{l.name}</a></li>
            ))}
          </ul>
        </details>
      )}
      <a class="btn btn--small" href={`${home}#download`}>{tx.download}</a>
    </nav>
  </div>
</header>
