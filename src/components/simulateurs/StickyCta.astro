---
// Bottom bar "Résultats par email" → scrolls to the lead form (src/scripts/simulateurs/sticky-cta.ts shows it).
---

<aside id="s2m-sticky-cta" class="sticky-cta" aria-label="Recevoir mes résultats">
  <div class="sticky-cta__text">
    <p class="sticky-cta__title">Résultats par email</p>
    <p class="sticky-cta__sub">Gratuit, sans engagement</p>
  </div>
  <button type="button">Recevoir →</button>
</aside>

<script>
  import '../../scripts/simulateurs/sticky-cta';
</script>

<style>
  .sticky-cta {
    position: fixed;
    inset: auto 0 0;
    z-index: 9990;
    display: flex;
    gap: 0.875rem;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    background: var(--neutral-large);
    color: var(--white);
    box-shadow: 0 -6px 20px color-mix(in srgb, var(--neutral-strong) 22%, transparent);
    letter-spacing: normal;
    transform: translateY(100%);
    visibility: hidden;
    transition: transform 0.35s ease, visibility 0s 0.35s;
  }
  .sticky-cta[data-show] { transform: none; visibility: visible; transition: transform 0.35s ease; }
  .sticky-cta__text { min-width: 0; }
  .sticky-cta p { margin: 0; line-height: 1.2; }
  .sticky-cta__title { overflow: hidden; font-size: 0.9375rem; font-weight: var(--weight-bold); white-space: nowrap; text-overflow: ellipsis; }
  .sticky-cta__sub { font-size: 0.75rem; opacity: 0.72; }
  .sticky-cta button {
    flex: none;
    min-height: 44px;
    padding: 0.75rem 1.125rem;
    border: 0;
    border-radius: 9px;
    background: var(--primary);
    color: var(--white);
    font-size: 0.875rem;
    font-weight: var(--weight-bold);
    white-space: nowrap;
    cursor: pointer;
  }
  @media (max-width: 600px) {
    .sticky-cta { padding: 0.625rem 0.75rem; }
    .sticky-cta__title { font-size: 0.875rem; }
    .sticky-cta button { font-size: 16px; }
  }
</style>
