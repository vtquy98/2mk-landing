---
// "Recevez vos résultats par email" form of every simulator. Rendered hidden; src/scripts/simulateurs/lead-form.ts
// moves it under the simulator's results once they are shown, and posts it to the lead endpoint.
import { PRODUCT } from '../../i18n/config';
import { PRIVACY_URL } from '../../scripts/lead';

interface Props { slug: string }
const { slug } = Astro.props;
const viager = /viager/i.test(slug);
const th = /taxe-habitation/i.test(slug);
const tf = /taxe-fonciere/i.test(slug) || th;
const variant = th ? 'th' : tf ? 'tf' : viager ? 'viager' : 'scpi';
const simulatorId = /^[a-z0-9-]{3,60}$/.test(slug) ? slug : 'simulateur';

const actions = [
  { value: 'resultat', title: 'Résultats par email uniquement', desc: 'Recevez vos chiffres, sans suite particulière.' },
  { value: 'signup', title: 'Créer un compte gratuit', desc: 'Accédez aux annonces et fonctionnalités 2nd Market.' },
  viager
    ? { value: 'annonce', title: "Dépôt d'annonce viager", desc: 'Publier votre bien viager gratuitement sur la marketplace.' }
    : { value: 'annonce', title: "Dépôt d'annonce", desc: 'Publier votre bien gratuitement sur la marketplace.' },
  ...(viager ? [{ value: 'conseiller', title: 'Être mis en relation avec un partenaire viager', desc: 'Un notaire ou expert viager partenaire vous rappelle sous 48h.' }] : []),
];
const phoneHelp = viager ? 'Optionnel — obligatoire si vous demandez à être rappelé.' : 'Optionnel.';
const disclaimer = !tf
  ? '2nd Market est une plateforme de mise en relation. Ni CGP, ni CIF, ni société de gestion. Les simulations sont indicatives et ne constituent pas un conseil en investissement.'
  : `2nd Market est une plateforme de mise en relation : ni cabinet juridique, ni conseiller fiscal. Les estimations sont indicatives. La vérification ne garantit pas une réduction ${th ? 'de l’impôt' : 'de votre taxe foncière'}.`;
---

<form id="market2nd-lead-form" class="lead" hidden novalidate data-simulator-id={simulatorId} data-variant={variant} data-app={PRODUCT.app} data-viager-app={PRODUCT.viagerApp}>
  <div class="lead__card">
    <div class="lead__head">
      <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" /><polyline points="22,6 12,13 2,6" /></svg>
      <h3>{tf ? 'Recevez votre estimation par email' : 'Recevez vos résultats par email'}</h3>
      <p>Gratuit • Sans engagement • Données confidentielles</p>
    </div>

    <div id="lead-form-content" class="lead__body">
      <div class="lead__names">
        <input type="text" id="lead-firstname" placeholder="Prénom" aria-label="Prénom" autocomplete="given-name" />
        <input type="text" id="lead-lastname" placeholder="Nom" aria-label="Nom" autocomplete="family-name" />
      </div>
      <input type="email" id="lead-email" placeholder="Votre adresse email" aria-label="Adresse email" autocomplete="email" />
      <div class="lead__phone" hidden={tf}>
        <input type="tel" id="lead-phone" placeholder={viager ? 'Téléphone (requis pour rappel partenaire)' : 'Téléphone (optionnel)'} aria-label="Téléphone" aria-describedby="lead-phone-help" autocomplete="tel" pattern="[0-9 +().\-]{6,20}" />
        <p id="lead-phone-help">{phoneHelp}</p>
      </div>

      <fieldset class="lead__actions">
        {tf ? (
          <>
            <input type="radio" name="lead-action" value="resultat" checked hidden />
            <p class="lead__info">
              {`Vous recevez votre estimation, avec la présentation de notre service de vérification ${th ? 'de la valeur locative' : 'de la taxe foncière'}, opéré avec `}
              <strong>Solucia Protection Juridique</strong>{`, dès 9 €.${th ? ' Cette valeur sert au calcul de la taxe foncière et de la taxe d’habitation d’une résidence secondaire.' : ''}`}
            </p>
          </>
        ) : (
          <>
            <legend>Souhaitez-vous aller plus loin&nbsp;?</legend>
            {actions.map((a, i) => (
              <label class="lead__action">
                <input type="radio" name="lead-action" value={a.value} checked={i === 0} />
                <span><strong>{a.title}</strong>{a.desc}</span>
              </label>
            ))}
          </>
        )}
      </fieldset>

      <div class="lead__consent">
        <input type="checkbox" id="lead-consent" />
        <label for="lead-consent">
          J'accepte de recevoir mes résultats et des informations de 2nd Market. <a href={PRIVACY_URL} target="_blank" rel="noopener">Politique de confidentialité</a>
        </label>
      </div>

      <button id="lead-submit" type="submit" class="lead__submit">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><line x1="22" y1="2" x2="11" y2="13" /><polygon points="22 2 15 22 11 13 2 9 22 2" /></svg>
        <span class="lead__submit-idle">Recevoir mes résultats</span><span class="lead__submit-busy">Envoi en cours...</span>
      </button>
      <p id="lead-error" class="lead__error" role="alert" hidden></p>
      <p class="lead__disclaimer">{disclaimer}</p>
      <ul class="lead__trust">
        <li>🔒 Sécurisé</li>
        <li>✅ 0 spam</li>
        <li>✉️ Désinscription libre</li>
      </ul>
    </div>

    <div id="lead-success" class="lead__success" hidden aria-live="polite">
      <div class="lead__check">
        <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M22 11.08V12a10 10 0 11-5.93-9.14" /><polyline points="22 4 12 14.01 9 11.01" /></svg>
      </div>
      <h3 id="lead-success-title">Résultats envoyés&nbsp;!</h3>
      <p id="lead-success-text">Vérifiez votre boîte de réception.<br />Pensez à vérifier vos spams si besoin.</p>
      <a id="lead-success-cta" class="lead__cta" href="/simulateurs" target="_blank" rel="noopener" hidden></a>
    </div>
  </div>
</form>

<script>
  import '../../scripts/simulateurs/lead-form';
</script>

<style>
  /* The form sits inside a calculator embed whose own styles (h3, label, input…) must not leak in. */
  #market2nd-lead-form :is(div, h3, p, label, input, button, a, strong, span, small, ul, li, fieldset, legend) {
    all: revert;
    box-sizing: border-box;
    font-family: inherit;
    letter-spacing: inherit;
  }
  #market2nd-lead-form [hidden] { display: none; }
  #market2nd-lead-form {
    /* No token for these yet (success green, tax-service bordeaux): candidates for global.css. */
    --lead-ok: var(--success-alt);
    --lead-ok-bg: var(--success-alt-light);
    --lead-tax: var(--tax);
    --lead-tax-bg: var(--tax-light);
    --lead-tax-border: var(--tax-border);
    width: 100%;
    margin-top: 2rem;
    color: var(--color-text);
    font-family: var(--font);
    font-size: 1rem;
    font-weight: var(--weight-regular);
    line-height: 1.5;
    letter-spacing: normal;
  }
  #market2nd-lead-form .lead__card {
    overflow: hidden;
    border: 2px solid var(--neutral-lightest);
    border-radius: 1rem;
    background: var(--white);
    box-shadow: 0 8px 30px color-mix(in srgb, var(--neutral-strong) 12%, transparent);
    animation: lead-up 0.5s ease;
  }
  @keyframes lead-up { from { opacity: 0; transform: translateY(20px); } }

  #market2nd-lead-form .lead__head { padding: 1.75rem; background: var(--neutral-large); color: var(--white); text-align: center; }
  #market2nd-lead-form .lead__head svg { margin-bottom: 0.625rem; opacity: 0.85; }
  #market2nd-lead-form .lead__head h3 { margin: 0 0 0.375rem; font-size: 1.25rem; font-weight: var(--weight-bold); line-height: 1.3; letter-spacing: normal; }
  #market2nd-lead-form .lead__head p { margin: 0; font-size: 0.875rem; opacity: 0.7; }

  #market2nd-lead-form .lead__body { padding: 1.75rem; }
  #market2nd-lead-form .lead__names { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.75rem; }
  #market2nd-lead-form .lead__names input { flex: 1 1 200px; }
  #market2nd-lead-form input:is([type='text'], [type='email'], [type='tel']) {
    width: 100%;
    min-height: 3rem;
    padding: 0.875rem 1rem;
    border: 2px solid var(--neutral-lightest);
    border-radius: 0.625rem;
    outline: none;
    background: var(--neutral-bg);
    color: var(--color-text);
    font-size: 1rem;
    transition: border-color 0.2s;
  }
  #market2nd-lead-form input:focus-visible { border-color: var(--neutral-large); }
  #market2nd-lead-form #lead-email { margin-bottom: 0.75rem; }
  #market2nd-lead-form .lead__phone { margin-bottom: 1.25rem; }
  #market2nd-lead-form .lead__phone p { margin: 0.375rem 0 0; font-size: 0.75rem; color: var(--color-text-muted); }
  #market2nd-lead-form[data-phone='ok'] #lead-phone { border-color: var(--lead-ok); }
  #market2nd-lead-form[data-phone='ok'] .lead__phone p { color: var(--lead-ok); }
  #market2nd-lead-form[data-phone='missing'] #lead-phone { border-color: var(--primary-light); }
  #market2nd-lead-form[data-phone='missing'] .lead__phone p { color: var(--primary-strong); }

  #market2nd-lead-form .lead__actions { margin: 0 0 1.125rem; padding: 0; border: 0; }
  #market2nd-lead-form .lead__actions legend { margin-bottom: 0.625rem; padding: 0; font-size: 0.875rem; font-weight: var(--weight-semibold); color: var(--color-text); }
  #market2nd-lead-form .lead__action {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 0.5rem;
    padding: 0.75rem 0.875rem;
    border: 2px solid var(--neutral-lightest);
    border-radius: 0.625rem;
    font-weight: inherit;
    cursor: pointer;
    transition: background-color 0.15s, border-color 0.15s;
  }
  #market2nd-lead-form .lead__action:hover { border-color: var(--neutral-light); background: var(--neutral-bg); }
  #market2nd-lead-form .lead__action:has(:checked) { border-color: var(--neutral-large); background: color-mix(in srgb, var(--neutral-large) 6%, var(--white)); }
  #market2nd-lead-form .lead__action input { width: 18px; height: 18px; min-width: 18px; margin: 2px 0 0; accent-color: var(--neutral-large); cursor: pointer; }
  #market2nd-lead-form .lead__action span { flex: 1; font-size: 0.8125rem; line-height: 1.4; color: var(--color-text-muted); }
  #market2nd-lead-form .lead__action strong { display: block; margin-bottom: 2px; font-size: 0.875rem; font-weight: var(--weight-semibold); line-height: 1.5; color: var(--color-text); }
  #market2nd-lead-form .lead__info {
    margin: 0;
    padding: 0.75rem 0.875rem;
    border: 1px solid var(--lead-tax-border);
    border-radius: 0.625rem;
    background: var(--lead-tax-bg);
    font-size: 0.8125rem;
    color: var(--color-text);
  }

  #market2nd-lead-form .lead__consent { display: flex; gap: 0.625rem; align-items: flex-start; margin-bottom: 1rem; }
  #market2nd-lead-form .lead__consent input { width: 20px; height: 20px; min-width: 20px; margin: 1px 0 0; accent-color: var(--neutral-large); cursor: pointer; }
  #market2nd-lead-form .lead__consent label { margin: 0; font-size: 0.8125rem; font-weight: inherit; color: var(--color-text-muted); cursor: pointer; }
  #market2nd-lead-form .lead__consent a { color: var(--neutral-large); font-weight: var(--weight-semibold); text-decoration: underline; }

  #market2nd-lead-form .lead__submit {
    display: flex;
    gap: 0.625rem;
    align-items: center;
    justify-content: center;
    width: 100%;
    min-height: 3.25rem;
    padding: 1rem;
    border: 0;
    border-radius: 0.625rem;
    background: var(--primary);
    color: var(--white);
    font-size: 1rem;
    font-weight: var(--weight-bold);
    letter-spacing: normal;
    box-shadow: 0 4px 14px color-mix(in srgb, var(--primary) 25%, transparent);
    cursor: pointer;
    transition: all 0.25s;
  }
  #market2nd-lead-form .lead__submit:disabled { opacity: 0.5; cursor: not-allowed; }
  #market2nd-lead-form .lead__submit-busy, #market2nd-lead-form .lead__submit[data-sending] :is(svg, .lead__submit-idle) { display: none; }
  #market2nd-lead-form .lead__submit[data-sending] .lead__submit-busy { display: inline; }
  #market2nd-lead-form .lead__error {
    margin: 0.75rem 0 0;
    padding: 0.625rem 0.875rem;
    border-radius: 0.5rem;
    background: var(--primary-lightest);
    color: var(--primary-strong);
    font-size: 0.8125rem;
    text-align: center;
  }
  #market2nd-lead-form .lead__disclaimer { margin: 0.875rem 0 0; font-size: 0.6875rem; color: var(--color-text-subtle); text-align: center; }
  #market2nd-lead-form .lead__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    margin: 0.875rem 0 0;
    padding: 0.875rem 0 0;
    border-top: 1px solid var(--neutral-bg);
    list-style: none;
    font-size: 0.75rem;
    color: var(--color-text-subtle);
  }

  #market2nd-lead-form .lead__success { padding: 2.5rem 1.75rem; text-align: center; }
  #market2nd-lead-form .lead__check {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4rem;
    height: 4rem;
    margin: 0 auto 1.25rem;
    border-radius: 50%;
    background: var(--lead-ok-bg);
    color: var(--lead-ok);
  }
  #market2nd-lead-form .lead__success h3 { margin: 0 0 0.625rem; font-size: 1.25rem; font-weight: var(--weight-bold); letter-spacing: normal; color: var(--color-text); }
  #market2nd-lead-form .lead__success p { margin: 0 0 1.5rem; font-size: 0.9375rem; line-height: 1.6; color: var(--color-text-muted); }
  #market2nd-lead-form .lead__success p :global(small) { display: block; margin-top: 0.5rem; font-size: 0.6875rem; color: var(--color-text-subtle); }
  #market2nd-lead-form .lead__cta {
    display: inline-flex;
    gap: 0.5rem;
    align-items: center;
    min-height: 3rem;
    padding: 0.875rem 1.75rem;
    border-radius: 0.625rem;
    background: var(--neutral-large);
    color: var(--white);
    font-size: 0.9375rem;
    font-weight: var(--weight-bold);
  }
  #market2nd-lead-form .lead__cta[hidden] { display: none; }
  #market2nd-lead-form .lead__cta[data-tone='primary'] { background: var(--primary); }
  #market2nd-lead-form .lead__cta[data-tone='tax'] { background: var(--lead-tax); }

  @media (max-width: 600px) {
    #market2nd-lead-form { margin-top: 1.25rem; }
    #market2nd-lead-form .lead__head, #market2nd-lead-form .lead__body, #market2nd-lead-form .lead__success { padding: 1.125rem; }
    #market2nd-lead-form .lead__action { padding: 0.625rem 0.75rem; }
    #market2nd-lead-form .lead__submit { font-size: 0.9375rem; }
  }
</style>
