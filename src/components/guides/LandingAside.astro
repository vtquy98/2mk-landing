---
// Sidebar of every landing page: sell CTA (a fixed bar at the bottom of the screen on mobile) and press mentions.
import { PRODUCT } from '../../i18n/config';

const press = [
  {
    href: 'https://www.lemonde.fr/article-offert/ca6c1ec90707-6607704/scpi-des-epargnants-toujours-dans-l-impossibilite-de-revendre-leurs-parts',
    label: 'On parle de nous dans Le Monde',
    img: { src: '/assets/68415ae8ad1ffd510c4bd7d9_image-11.avif', srcset: '/assets/68415ae8ad1ffd510c4bd7d9_image-11-p-500.avif 500w, /assets/68415ae8ad1ffd510c4bd7d9_image-11.avif 828w', alt: 'Coupure de presse Le Monde', width: 828, height: 621 },
  },
  {
    href: 'https://www.lemonde.fr/article-offert/ca6c1ec90707-6607704/scpi-des-epargnants-toujours-dans-l-impossibilite-de-revendre-leurs-parts',
    label: 'Le Figaro Magazine parle de 2nd Market',
    img: { src: '/assets/684661d67fd6c5716d69556c_image-12.avif', srcset: '/assets/684661d67fd6c5716d69556c_image-12-p-500.avif 500w, /assets/684661d67fd6c5716d69556c_image-12-p-800.avif 800w, /assets/684661d67fd6c5716d69556c_image-12.avif 1875w', alt: 'Coupure de presse Le Figaro', width: 1875, height: 1399 },
  },
  {
    href: 'https://www.lesechos.fr/',
    label: 'Immobilier : comment réussir à vendre rapidement ses SCPI',
    img: { src: '/assets/684661d55fb736ed3a1b66d0_Frame-124031.avif', srcset: '/assets/684661d55fb736ed3a1b66d0_Frame-124031-p-500.avif 500w, /assets/684661d55fb736ed3a1b66d0_Frame-124031-p-800.avif 800w, /assets/684661d55fb736ed3a1b66d0_Frame-124031-p-1080.avif 1080w, /assets/684661d55fb736ed3a1b66d0_Frame-124031.avif 1875w', alt: 'Coupure de presse Les Echos', width: 1875, height: 1399 },
  },
];
---

<aside class="aside">
  <div class="cta">
    <div class="logo" aria-hidden="true">
      <svg viewBox="0 0 97 97" fill="none">
        <path d="M91.1201 94.3594H5.07031V78.7139H91.1201V94.3594ZM37.3389 70.0332H17.9775V24.8574H37.3389V70.0332ZM76.0625 70.0332H56.7012V24.8574H76.0625V70.0332ZM91.1201 16.1455H5.07031V0.5H91.1201V16.1455Z" fill="currentColor" />
      </svg>
    </div>
    <div class="cta-content">
      <p class="cta-text">Revendez vos parts SCPI rapidement, en toute simplicité.</p>
      <div class="cta-links">
        <a class="pill" href={`${PRODUCT.app}/create`}>Vendre</a>
        <a class="pill" href="/">Explorer</a>
      </div>
    </div>
  </div>
  <div class="press">
    <p class="press-title">On parle de nous:</p>
    <ul>
      {
        press.map(p => (
          <li>
            <a class="press-item" href={p.href} target="_blank" rel="noopener">
              <img src={p.img.src} srcset={p.img.srcset} sizes="(max-width: 991px) 50vw, 8rem" alt={p.img.alt} width={p.img.width} height={p.img.height} loading="lazy" decoding="async" />
              <span>{p.label}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</aside>

<style>
  .aside { position: sticky; top: 12rem; flex: none; display: flex; flex-direction: column; gap: var(--size-2); width: 30%; }
  .cta { position: relative; display: flex; flex-direction: column; gap: var(--size-0-75); padding: var(--size-3) var(--size-1-5) var(--size-1-5); border-radius: var(--radius-main); background: var(--white); text-align: center; }
  .logo {
    position: absolute; inset: 0 0 auto; display: flex; justify-content: center; align-items: center;
    width: 6rem; height: 6rem; margin: -3.5rem auto 0; padding: var(--size-1-5);
    border-radius: var(--radius-round); background: var(--white); box-shadow: var(--shadow-xxlarge); color: var(--primary);
  }
  .logo svg { width: 100%; height: 100%; }
  .cta-content { display: flex; flex-direction: column; gap: var(--size-1); }
  .cta-text { margin: 0; font-weight: var(--weight-medium); }
  .cta-links { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: var(--size-0-5); }
  .pill {
    display: inline-block; padding: var(--size-0-5) var(--size-1);
    border: 1px solid var(--primary); border-radius: var(--radius-round); background: var(--white);
    color: var(--primary); font-size: 0.875rem; line-height: var(--lh-1-4); transition: background-color 0.4s;
  }
  .pill:hover { background: var(--primary-lightest); }
  .press { display: flex; flex-direction: column; gap: var(--size-0-5); }
  .press-title { margin: 0; }
  ul { display: flex; flex-direction: column; gap: var(--size-0-75); margin: 0; padding: 0; list-style: none; }
  .press-item {
    display: flex; align-items: center; gap: var(--size-1); padding: var(--size-0-5);
    border-radius: var(--radius-medium); background: var(--white); color: var(--color-bg-dark);
    box-shadow: 0 20px 50px color-mix(in srgb, var(--neutral-strong) 3%, transparent);
    transition: transform 0.4s, box-shadow 0.4s;
  }
  .press-item:hover { transform: translateY(-0.25rem); box-shadow: 0 20px 50px color-mix(in srgb, var(--neutral-strong) 12%, transparent); }
  .press-item img { flex: none; width: 8rem; aspect-ratio: 4 / 3; height: auto; border-radius: var(--radius-small); box-shadow: var(--shadow-xsmall); }
  .press-item span { flex: 1; font-weight: var(--weight-regular); line-height: var(--lh-1-4); }
  @media (max-width: 991px) {
    .press-item img { width: 50%; }
  }
  @media (max-width: 767px) {
    .aside { position: relative; top: 0; width: 100%; }
    .cta {
      position: fixed; inset: auto 0 0; z-index: 100; flex-direction: row; gap: var(--size-0-75);
      margin: 0 var(--size-0-5) var(--size-0-5) var(--size-0-75); padding: var(--size-1) var(--size-2) var(--size-1) var(--size-1);
      text-align: left; box-shadow: 0 20px 40px color-mix(in srgb, var(--neutral-strong) 19%, transparent);
    }
    .logo { position: relative; order: -1; flex: none; margin: 0; }
    .cta-content { gap: var(--size-0-5); align-items: flex-start; }
    .cta-links { justify-content: flex-start; }
    .pill { padding: var(--size-0-25) var(--size-0-75); }
  }
  @media (max-width: 479px) {
    .cta { padding-right: var(--size-1); gap: var(--size-1); }
    .logo { width: 3rem; height: 3rem; padding: var(--size-0-5); }
    .cta-text { font-size: 0.875rem; }
    .pill { line-height: var(--lh-1-3); }
    .press-item img { width: auto; flex: 0 0 50%; }
  }
</style>
