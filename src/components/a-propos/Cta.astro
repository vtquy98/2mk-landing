---
// "Prêt à vendre ou acheter ?" dark call-to-action card over the faded wordmark.
import Button from '../ui/Button.astro';
import { PRODUCT } from '../../i18n/config';
---

<section class="gutter">
  <div class="container">
    <div class="card" data-reveal>
      <div class="content">
        <h2 class="h2" data-reveal>Prêt à vendre ou acheter ?</h2>
        <p class="text-medium" data-reveal>
          Créez votre annonce, trouvez des acheteurs. C'est aussi simple que ça ! Rejoignez-nous dès aujourd'hui et découvrez comment 2nd Market peut simplifier la vente ou l’achat de vos actifs immobiliers.
        </p>
        <Button href={`${PRODUCT.app}/scpi`}>Voir les annonces</Button>
      </div>
      <img class="wordmark" src="/assets/67443b2e9369c2292c34f558_2nd-Market.svg" alt="" width="799" height="125" loading="lazy" decoding="async" />
    </div>
  </div>
</section>

<style>
  .card {
    position: relative;
    width: 80%;
    margin-inline: auto;
    padding: 6rem;
    border-radius: var(--radius-large);
    background: var(--color-bg-medium);
    color: var(--color-text-light);
    text-align: center;
  }
  .content { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: var(--size-1); width: 90%; margin-inline: auto; }
  .content p { margin: 0; }
  .wordmark { position: absolute; inset: auto 0 0; width: 100%; }

  @media (max-width: 991px) { .card { width: 100%; padding: 4rem; } }
  @media (max-width: 767px) { .card { padding: var(--size-2); } }
  @media (max-width: 479px) { .card { padding: var(--size-1); } }
</style>
