---
// Group of custom radios (round, primary ring when checked) in a fieldset.
interface Props {
  name: string;
  legend: string;
  options: string[]; // label = submitted value
  required?: boolean;
  hideLegend?: boolean; // Webflow showed no label above the civility radios
  row?: boolean; // options side by side
}
const { name, legend, options, required = false, hideLegend = false, row = false } = Astro.props;
---

<fieldset class="group">
  <legend class:list={['legend', { 'visually-hidden': hideLegend }]}>{legend}</legend>
  <div class:list={['options', { 'options--row': row }]}>
    {
      options.map(o => (
        <label class="radio">
          <input type="radio" name={name} value={o} required={required} />
          <span>{o}</span>
        </label>
      ))
    }
  </div>
</fieldset>

<style>
  .group { margin: 0; padding: 0; border: 0; min-width: 0; }
  .legend { margin-bottom: var(--size-0-5); padding: 0; font-size: var(--text-medium-size); font-weight: var(--weight-regular); line-height: var(--lh-1-4); letter-spacing: var(--ls-4); }
  .options { display: flex; flex-direction: column; gap: var(--size-0-5); }
  .options--row { flex-direction: row; gap: var(--size-1-5); }
  .radio { display: flex; align-items: center; gap: var(--size-0-5); margin: 0; cursor: pointer; }
  input {
    appearance: none;
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0;
    border: 1px solid var(--color-text-muted);
    border-radius: 50%;
    background: var(--white);
    cursor: pointer;
    transition: border 0.15s;
  }
  input:checked { border: 4px solid var(--primary); }
  input:user-invalid { border-color: var(--primary); }
</style>
