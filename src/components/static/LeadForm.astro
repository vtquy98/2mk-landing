---
// Form posting its fields as a lead (src/scripts/lead.ts), then sending the visitor to /merci.
// Fields go in the slot (Field / RadioGroup); every named field is sent under its `name`, with `email` required.
// Spam: a honeypot field and a minimum fill time; bots get the /merci page but nothing is sent.
import Button from '../ui/Button.astro';

interface Props {
  leadAction: 'contact' | 'questionnaire' | 'qrcode';
  label: string; // accessible name of the form
  submit: string; // button text
  wideSubmit?: boolean; // full-width button (questionnaire) instead of a centred one
}
const { leadAction, label, submit, wideSubmit = false } = Astro.props;
---

<form class="form" data-lead={leadAction} aria-label={label}>
  <slot />
  <div class="trap" aria-hidden="true">
    <label>Ne pas remplir <input name="website" tabindex="-1" autocomplete="off" /></label>
  </div>
  <div class:list={['actions', { 'actions--wide': wideSubmit }]}>
    <Button type="submit" data-wait="Please wait...">{submit}</Button>
  </div>
  <p class="error" role="alert" hidden>Oops! Something went wrong while submitting the form.</p>
</form>

<script>
  import { sendLead, leadContext } from '../../scripts/lead';

  const MIN_FILL_MS = 3000; // a human needs more than 3 s to fill any of these forms

  for (const form of document.querySelectorAll<HTMLFormElement>('form[data-lead]')) {
    const started = Date.now();
    const action = form.dataset.lead!;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const error = form.querySelector<HTMLElement>('.error')!;

    form.addEventListener('submit', async event => {
      event.preventDefault();
      const { website, ...fields } = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (website || Date.now() - started < MIN_FILL_MS) return location.assign('/merci');

      error.hidden = true;
      const text = button.textContent;
      button.disabled = true;
      button.textContent = button.dataset.wait!;
      const ok = await sendLead({ leadAction: action, email: fields.email ?? '', ...fields, ...leadContext(action) });
      if (ok) return location.assign('/merci');
      button.disabled = false;
      button.textContent = text;
      error.hidden = false;
    });
  }
</script>

<style>
  .form { display: flex; flex-direction: column; gap: var(--size-1); margin-bottom: var(--size-1); }
  .trap { position: absolute; left: -100vw; width: 1px; height: 1px; overflow: hidden; }
  .actions { display: flex; justify-content: center; padding-top: var(--size-1); }
  .actions--wide { padding-top: 0; }
  .actions--wide :global(.button) { width: 100%; }
  .actions :global(button:disabled) { opacity: 0.7; cursor: wait; }
  .error {
    margin: var(--size-0-5) 0 0;
    padding: 0.875rem 1rem;
    border-radius: var(--radius-small);
    background: var(--primary-lightest);
    color: var(--primary-strong);
  }
  @media (max-width: 767px) { .actions { padding-top: 0.75rem; } }
</style>
