---
// Article card (hub tabs, "Découvrez également"). The whole card is one link.
import CategoryTag from './CategoryTag.astro';
import type { Actualite } from '../../lib/actualites';

interface Props {
  entry: Actualite;
}
const { entry } = Astro.props;
const { title, excerpt, image, imageAlt, imageWidth, imageHeight, imageSrcset, category } = entry.data;
---

<a class="card" href={`/actualites/${entry.id}`}>
  <div class="media">
    {
      image && (
        <img
          src={image}
          srcset={imageSrcset}
          sizes={imageSrcset ? '(max-width: 479px) 100vw, (max-width: 1440px) 30vw, 420px' : undefined}
          alt={imageAlt ?? ''}
          width={imageWidth}
          height={imageHeight}
          loading="lazy"
          decoding="async"
        />
      )
    }
  </div>
  <div class="content">
    <div>
      <h3 class="title">{title}</h3>
      {excerpt && <p class="excerpt clamp-2">{excerpt}</p>}
    </div>
    <div class="footer">
      {category && <CategoryTag label={category} />}
      <span class="more">
        Lire la suite
        <svg viewBox="0 0 25 25" aria-hidden="true"><path d="M20.82 12.69l-6.75 6.75a.75.75 0 0 1-1.06-1.06l5.47-5.47H3.79a.75.75 0 0 1 0-1.5h14.69l-5.47-5.47a.75.75 0 0 1 1.06-1.06l6.75 6.75a.75.75 0 0 1 0 1.06z" /></svg>
      </span>
    </div>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--size-0-25);
    border-radius: var(--radius-main);
    background: var(--white);
    color: var(--color-text);
    box-shadow: var(--shadow-xxlarge);
    transition: transform 0.4s, box-shadow 0.4s;
  }
  .card:hover { transform: translateY(-0.25rem); box-shadow: var(--shadow-xlarge); }
  .media { aspect-ratio: 16 / 9; border-radius: var(--radius-medium); overflow: clip; background: var(--neutral-lightest); }
  .media img { width: 100%; height: 100%; }
  .content { display: flex; flex: 1; flex-direction: column; justify-content: space-between; gap: var(--size-2); padding: var(--size-0-5) var(--size-1) var(--size-1); }
  .title { margin-block: var(--size-0-25) var(--size-0-5); font-size: var(--text-medium-size); font-weight: var(--weight-medium); line-height: var(--lh-1-4); letter-spacing: var(--ls-4); }
  .excerpt { margin: 0; color: var(--neutral-large); }
  .footer { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: var(--size-0-5); }
  .more { display: flex; align-items: center; gap: var(--size-0-5); padding-block: var(--size-0-25); color: var(--primary); line-height: var(--lh-1); }
  .more svg { width: var(--size-1-5); height: var(--size-1-5); fill: currentColor; }
</style>
