---
import type { Icon } from './icons';
interface Props { icon: Icon; size?: number; class?: string }
const { icon, size = 24, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox={icon.viewBox} fill="currentColor" aria-hidden="true">
  <path d={icon.d} fill-rule={icon.evenodd ? 'evenodd' : undefined} clip-rule={icon.evenodd ? 'evenodd' : undefined} />
</svg>
