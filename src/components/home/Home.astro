---
// Home page, shared by every language: sections in order, all texts from src/i18n/<lang>.json.
// Add a section: new component in this folder, its texts under a new key in en.json (and every other <lang>.json).
import StoreButtons from '../StoreButtons.astro';
import { t } from '../../i18n/config';

interface Props { lang: string }
const { lang } = Astro.props;
const tx = t(lang);
---

<section class="hero">
  <div class="container">
    <p class="eyebrow">{tx.hero.eyebrow}</p>
    <h1>{tx.hero.title}</h1>
    <p class="lead">{tx.hero.lead}</p>
    <StoreButtons lang={lang} />
  </div>
</section>

<section id="features" class="section">
  <div class="container">
    <h2>{tx.features.title}</h2>
    <ul class="grid">
      {tx.features.items.map(f => (
        <li class="card">
          <h3>{f.title}</h3>
          <p>{f.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section id="faq" class="section">
  <div class="container container--narrow">
    <h2>{tx.faq.title}</h2>
    {tx.faq.items.map(f => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<section id="download" class="section cta">
  <div class="container">
    <h2>{tx.cta.title}</h2>
    <p>{tx.cta.text}</p>
    <StoreButtons lang={lang} />
  </div>
</section>
