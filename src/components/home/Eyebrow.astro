---
// Small pill above a section heading ("SCPI — Annonces disponibles").
// tone: "secondary" = gold on cream (light sections), "glass" = translucent white (dark/video backgrounds).
import BrandMark from './icons/brand-mark.svg';

interface Props {
  tone?: 'secondary' | 'glass';
  icon?: boolean;
  class?: string;
}
const { tone = 'secondary', icon = true, class: cls } = Astro.props;
---

<div class:list={['eyebrow', `eyebrow--${tone}`, cls]}>
  {icon && (<slot name="icon"><BrandMark class="eyebrow__icon" aria-hidden="true" /></slot>)}
  <span class="eyebrow__text"><slot /></span>
</div>

<style>
  .eyebrow {
    display: inline-flex;
    gap: var(--size-0-5);
    align-items: center;
    padding: var(--size-0-25) var(--size-0-75) var(--size-0-25) var(--size-0-5);
    border: 1px solid;
    border-radius: var(--radius-round);
    white-space: nowrap;
  }
  .eyebrow--secondary { border-color: var(--secondary-light); background: var(--secondary-lightest); color: var(--secondary); font-weight: var(--weight-medium); }
  .eyebrow--glass { border-color: color-mix(in srgb, var(--white) 10%, transparent); background: color-mix(in srgb, var(--white) 10%, transparent); color: var(--color-text-light); }
  .eyebrow :global(.eyebrow__icon) { flex: none; width: var(--size-1-5); height: var(--size-1-5); padding: 0.125rem; }
  @media (max-width: 479px) { .eyebrow--secondary { font-size: 0.875rem; } }
</style>
