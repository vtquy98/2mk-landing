---
// Dark rounded call-to-action block with the "2nd Market" wordmark in the background (simulators).
import './reveal.css';
import Button from '../ui/Button.astro';
---

<section class="cta gutter">
  <div class="container section">
    <div class="cta__box">
      <h2 class="h2 cta__title reveal">Simulateurs gratuits : frais, rendement, fiscalité, viager</h2>
      <p class="text-medium cta__text">Estimez votre net vendeur ou acheteur en 30 secondes. Calculez le rendement effectif avec décote. Simulez la taxe foncière, l'IFI ou un viager.</p>
      <Button href="/simulateurs">Accéder aux simulateurs</Button>
      <img class="cta__mark" src="/assets/67443b2e9369c2292c34f558_2nd-Market.svg" alt="" width="799" height="125" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .cta__box {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--size-1);
    align-items: center;
    width: 80%;
    margin-inline: auto;
    padding: 6rem;
    overflow: clip;
    border-radius: var(--radius-large);
    background: var(--color-bg-medium);
    color: var(--color-text-light);
    text-align: center;
  }
  .cta__box > :not(img) { position: relative; z-index: 1; }
  .cta__title, .cta__text { width: 90%; margin: 0; }
  .cta__mark { position: absolute; inset: auto 0 0; width: 100%; height: auto; }
  @media (max-width: 991px) { .cta__box { width: 100%; padding: 4rem; } }
  @media (max-width: 767px) { .cta__box { padding: var(--size-2); } }
</style>

<script>
  import './reveal';
</script>
