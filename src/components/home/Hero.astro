---
// Home hero: blurred background video, notary badge, H1, CTA, press logos, 4 key figures.
import Button from '../ui/Button.astro';
import Eyebrow from './Eyebrow.astro';
import ShieldCheck from './icons/shield-check.svg';
import { PRODUCT } from '../../i18n/config';

interface Props {
  title: string;
  stats: { value: string; label: string }[];
}
const { title, stats } = Astro.props;

const press = [
  { name: 'Les Echos', src: '/assets/6a0c0a3759511116dcfcba3c_Frame.avif', href: 'https://www.lesechos.fr/patrimoine/placement/immobilier-faut-il-miser-sur-le-rebond-de-la-pierre-papier-en-2026-2210970' },
  { name: 'Le Particulier', src: '/assets/6a0c0a379158a5a2afa830c5_Frame-1.avif', href: 'https://leparticulier.lefigaro.fr/jcms/c_113078/placements-immobiliers/scpi-peut-on-realiser-de-bonnes-affaires-en-achetant-des-parts-sur-le-marche-secondaire-20260219' },
  { name: 'Mieux Vivre Votre Argent', src: '/assets/68d9101ae6dba7ec8eda9544_logo.avif', href: '/assets/6a0c0cfcf68ccb3f7254a282_Mieux_Vivre_Votre_Argent_20251001120000.pdf', width: 112 },
];
---

<header class="hero gutter">
  <div class="hero__bg" aria-hidden="true">
    <video class="hero__video" autoplay muted loop playsinline preload="metadata" poster="/assets/6a0430df6a0fdaa00f71e982_hero-video_poster.0000000.jpg">
      <source src="/assets/6a0430df6a0fdaa00f71e982_hero-video_webm.webm" type="video/webm" />
      <source src="/assets/6a0430df6a0fdaa00f71e982_hero-video_mp4.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="container hero__inner">
    <div class="hero__content">
      <Eyebrow tone="glass" class="hero__badge">
        <ShieldCheck slot="icon" class="eyebrow__icon hero__shield" aria-hidden="true" />
        <span class="hero__badge-muted">Transactions sécurisées par </span>Notaire
      </Eyebrow>
      <h1 class="h1 hero__title">{title}</h1>
      <slot name="lead"><p class="hero__lead">Gré à gré · notaire · 4-8 semaines vs 600+ jours</p></slot>
      <slot name="actions"><Button href={`${PRODUCT.app}/scpi`}>Voir les annonces disponibles</Button></slot>
      <div class="hero__press">
        <p class="hero__press-label">On parle de nous</p>
        <ul class="hero__logos" role="list">
          {
            press.map(p => (
              <li>
                <a href={p.href} target="_blank" rel="noopener">
                  <img src={p.src} alt={p.name} width={p.width ?? 112} height="32" loading="lazy" decoding="async" />
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
    <ul class="hero__stats" role="list">
      {
        stats.map(s => (
          <li class="hero__stat">
            <p class="h3 hero__stat-value">{s.value}</p>
            <p class="hero__stat-label">{s.label}</p>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  // Background video: no motion for people who asked for less.
  if (matchMedia('(prefers-reduced-motion: reduce)').matches) document.querySelectorAll<HTMLVideoElement>('.hero__video').forEach(v => v.pause());
</script>

<style>
  .hero {
    position: relative;
    height: calc(100vh - 4.75rem);
    min-height: 40rem;
    margin-inline: var(--size-0-25);
    overflow: clip;
    border-radius: var(--radius-medium);
    color: var(--color-text-light);
  }
  .hero__bg { position: absolute; inset: 0; }
  .hero__bg::after {
    content: '';
    position: absolute;
    inset: 0;
    background: color-mix(in srgb, color-mix(in srgb, var(--neutral-strong) 25%, black) 60%, transparent);
    backdrop-filter: blur(8px);
  }
  .hero__video { width: 100%; height: 100%; object-fit: cover; }
  .hero__inner { position: relative; display: flex; flex-direction: column; gap: var(--size-3-5); justify-content: space-between; height: 100%; padding-block: var(--size-4) var(--size-2); }
  .hero__content { display: flex; flex-direction: column; gap: var(--size-1-5); align-items: center; text-align: center; }
  .hero :global(.hero__badge) { box-shadow: var(--shadow-large); font-size: 0.875rem; line-height: var(--lh-1-5); letter-spacing: var(--ls-2); }
  .hero__badge-muted { opacity: 0.5; }
  .hero :global(.hero__shield) { color: var(--positive-bright); }
  .hero__title { max-width: 48rem; text-wrap: balance; }
  .hero__lead { max-width: 35rem; margin: 0; opacity: 0.8; text-wrap: balance; }
  .hero__press { display: flex; flex-direction: column; gap: var(--size-1); width: min(100%, 23rem); margin-top: var(--size-0-5); }
  .hero__press-label { display: flex; gap: var(--size-1); align-items: center; margin: 0; font-size: 0.875rem; line-height: var(--lh-1-5); letter-spacing: var(--ls-2); }
  .hero__press-label::before, .hero__press-label::after { content: ''; flex: 1; height: 0.5px; background: linear-gradient(90deg, transparent, color-mix(in srgb, var(--white) 60%, transparent)); }
  .hero__press-label::after { transform: scaleX(-1); }
  .hero__press-label { color: color-mix(in srgb, var(--color-text-light) 50%, transparent); }
  .hero__logos { display: flex; list-style: none; flex-wrap: wrap; gap: var(--size-1); align-items: center; justify-content: center; margin: 0; padding: 0; }
  .hero__logos a { display: block; transition: transform 0.5s; }
  .hero__logos a:hover { transform: scale(0.95); }
  .hero__logos img { width: auto; height: var(--size-2); }
  .hero__stats { display: grid; list-style: none; grid-template-columns: repeat(4, 1fr); gap: var(--size-0-5); margin: 0; padding: 0; }
  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: var(--size-0-75);
    align-items: center;
    padding: var(--size-1-5);
    border: 1px solid color-mix(in srgb, var(--white) 10%, transparent);
    border-radius: var(--radius-medium);
    background: color-mix(in srgb, var(--white) 10%, transparent);
    backdrop-filter: blur(8px);
    text-align: center;
  }
  .hero__stat-value { margin-block: var(--size-0-5); }
  .hero__stat-label { margin: 0; color: var(--white); opacity: 0.6; text-wrap: balance; }
  @media (max-width: 767px) {
    .hero__stat { gap: var(--size-1-5); padding: var(--size-1); }
  }
  @media (max-width: 479px) {
    .hero { height: auto; min-height: 0; }
    .hero__inner { gap: var(--size-2); justify-content: flex-start; }
    .hero__press { gap: var(--size-0-75); }
    .hero__logos img { height: var(--size-1-75); }
    .hero__stats { grid-template-columns: 1fr 1fr; }
    .hero__stat { gap: var(--size-0-5); padding: var(--size-0-5); }
    .hero__stat-label { font-size: 0.875rem; }
  }
</style>
