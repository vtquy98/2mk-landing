---
// Centered heading + white rows (illustration, title, text): "Pourquoi acheter…", "Une cession sécurisée…".
import Eyebrow from './Eyebrow.astro';
import './reveal.css';

interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  items: { image: string; title: string; text: string }[]; // image: decorative, 1:1
}
const { eyebrow, title, description, items } = Astro.props;
---

<section class="benefits gutter">
  <div class="container section benefits__inner">
    <div class="benefits__heading reveal">
      {eyebrow && <Eyebrow>{eyebrow}</Eyebrow>}
      <h2 class="h2 benefits__title">{title}</h2>
      {description && <p class="benefits__description">{description}</p>}
    </div>
    <ul class="benefits__list" role="list">
      {
        items.map(item => (
          <li class="benefit reveal">
            <div class="benefit__head">
              <div class="benefit__icon"><img src={item.image} alt="" width="360" height="360" loading="lazy" decoding="async" /></div>
              <h3 class="h5 benefit__title">{item.title}</h3>
            </div>
            <p class="benefit__text">{item.text}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script>
  import './reveal';
</script>

<style>
  .benefits__inner { display: flex; flex-direction: column; gap: var(--size-2); }
  .benefits__heading { display: flex; flex-direction: column; gap: var(--size-1); align-items: center; text-align: center; }
  .benefits__title { max-width: 48rem; margin: 0; }
  .benefits__description { margin: 0; text-wrap: pretty; }
  .benefits__list { display: flex; flex-direction: column; gap: var(--size-1); align-items: center; margin: 0; padding: 0; list-style: none; }
  .benefit {
    display: flex;
    gap: var(--size-2);
    align-items: center;
    width: min(100%, 60rem);
    height: var(--size-12);
    padding: var(--size-0-5) var(--size-1-5) var(--size-0-5) var(--size-0-5);
    border-radius: var(--radius-main);
    background: var(--white);
  }
  .benefit__head { display: flex; flex: none; gap: var(--size-2-5); align-items: center; height: 100%; }
  .benefit__icon { display: flex; flex: none; align-items: center; justify-content: center; width: var(--size-12); height: 100%; padding: var(--size-2); border-radius: var(--radius-medium); background: var(--secondary-lightest); }
  .benefit__icon img { width: 100%; height: 100%; object-fit: contain; }
  .benefit__title { width: var(--size-16); margin: 0; font-weight: var(--weight-medium); text-wrap: balance; }
  .benefit__text { flex: 1; margin: 0; color: var(--neutral-large); text-wrap: pretty; }
  @media (max-width: 991px) {
    .benefit { gap: var(--size-1); height: var(--size-14); }
  }
  @media (max-width: 479px) {
    .benefit { flex-direction: column; align-items: stretch; height: auto; gap: var(--size-1); padding: var(--size-0-5) var(--size-0-5) var(--size-1); }
    .benefit__head { flex: none; gap: var(--size-2); height: 5.5rem; }
    .benefit__icon { width: 5.5rem; padding: var(--size-1-5); }
    .benefit__title { width: auto; font-size: var(--size-1-25); }
    .benefit__text { padding-inline: var(--size-0-5); }
  }
</style>
