---
// Thank-you page every form redirects to (no nav, no footer).
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/ui/Button.astro';
import seo from '../data/seo/merci.json';
---

<BaseLayout seo={seo} nav={false} footer={false} floatingButton={false} googleSources={false}>
  <div class="hero">
    <img
      class="bg"
      src="/assets/6746bb924b51a1c9b868cb0c_about-bg.avif"
      srcset="/assets/6746bb924b51a1c9b868cb0c_about-bg-p-500.avif 500w, /assets/6746bb924b51a1c9b868cb0c_about-bg-p-800.avif 800w, /assets/6746bb924b51a1c9b868cb0c_about-bg-p-1080.avif 1080w, /assets/6746bb924b51a1c9b868cb0c_about-bg.avif 2880w"
      sizes="100vw"
      alt=""
      width="2880"
      height="1272"
      fetchpriority="high"
      decoding="async"
    />
    <div class="content gutter">
      <svg class="check" viewBox="0 0 96 96" aria-hidden="true">
        <circle cx="48" cy="48" r="40" />
        <path d="M31 49l11 11 23-24" />
      </svg>
      <h1 class="h3"><span class="text-primary">Merci !</span> Nous vous contacterons très prochainement.</h1>
      <Button href="/">Découvrir 2nd Market</Button>
    </div>
  </div>
</BaseLayout>

<style>
  .hero { position: relative; overflow: clip; }
  /* Slow zoom-out of the background (Webflow "Reveal Hero": scale 1.3 -> 1 over 5 s). */
  .bg { position: absolute; inset: 0; width: 100%; height: 100%; animation: zoom-out 5s cubic-bezier(0.25, 1, 0.5, 1) both; }
  @keyframes zoom-out { from { scale: 1.3; } }
  .content {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 2rem;
    max-width: 40rem;
    min-height: 100vh;
    margin-inline: auto;
    text-align: center;
  }
  h1 { margin: 0; }

  /* Green check drawn in (was a Lordicon "approved" animation loaded from a third-party CDN). */
  .check { --check: #01d765; width: 6rem; height: 6rem; }
  .check circle { fill: var(--check); animation: pop 0.5s 0.35s cubic-bezier(0.34, 1.56, 0.64, 1) both; transform-origin: center; }
  .check path {
    fill: none;
    stroke: var(--white);
    stroke-width: 7;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 50;
    animation: draw 0.4s 0.7s ease-out both;
  }
  @keyframes pop { from { scale: 0; } }
  @keyframes draw { from { stroke-dashoffset: 50; } }

  @media (max-width: 991px) { .bg { object-position: 70% 50%; } }
  @media (max-width: 479px) { .bg { object-position: 50% 50%; } }
</style>
