---
import '../styles/global.css';
import { Font } from 'astro:assets';
import Analytics from '../components/Analytics.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import GoogleSources from '../components/GoogleSources.astro';
import FloatingButton from '../components/FloatingButton.astro';
import { defaultLocale, locales, PRODUCT, t } from '../i18n/config';
import siteGraph from '../data/site-jsonld.json';
import type { Seo } from '../lib/seo';

interface Props {
  seo: Seo;
  lang?: string;
  nav?: boolean; // false on funnel pages (questionnaire, qrcode, merci, maintenance)
  footer?: boolean;
  floatingButton?: boolean; // round CTA ≤ 991px: only on /, /viager, /observatoire-scpi, /home-new, /landing-pages/viager
}

const { seo, lang = defaultLocale, nav = true, footer = true, floatingButton = false } = Astro.props;
const locale = locales[lang];
const abs = (p?: string) => (p ? new URL(p, Astro.site).href : undefined);
const canonical = seo.canonical ?? abs(Astro.url.pathname);
const ogImage = abs(seo.ogImage);
const twitterImage = abs(seo.twitterImage);
---

<!doctype html>
<html lang={locale.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{seo.title}</title>
    {seo.description && <meta name="description" content={seo.description} />}
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={seo.robots ?? 'max-image-preview:large'} />
    <script is:inline>
      // Lets CSS tell whether JavaScript runs (menus fall back to plain links without it).
      document.documentElement.classList.add('js');
      // Previews (workers.dev, localhost) must never be indexed.
      if (!/^(www\.)?2ndmarket\.fr$/.test(location.hostname)) document.head.append(Object.assign(document.createElement('meta'), { name: 'robots', content: 'noindex, nofollow' }));
    </script>
    <link rel="icon" href="/assets/67444cfad0a02419af1f02e3_Favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/67444cfccde8d2a87758e883_Webclip.png" />
    <link rel="dns-prefetch" href={PRODUCT.app} />
    <Font cssVariable="--font-inter" preload />

    <meta property="og:type" content={seo.ogType ?? 'website'} />
    <meta property="og:site_name" content={PRODUCT.name} />
    <meta property="og:locale" content={locale.ogLocale} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={seo.ogTitle ?? seo.title} />
    {(seo.ogDescription ?? seo.description) && <meta property="og:description" content={seo.ogDescription ?? seo.description} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.twitterTitle ?? seo.ogTitle ?? seo.title} />
    {(seo.twitterDescription ?? seo.ogDescription ?? seo.description) && <meta name="twitter:description" content={seo.twitterDescription ?? seo.ogDescription ?? seo.description} />}
    {(twitterImage ?? ogImage) && <meta name="twitter:image" content={twitterImage ?? ogImage} />}

    <script type="application/ld+json" is:inline set:html={JSON.stringify(siteGraph)} />
    {seo.jsonLd?.map(j => <script type="application/ld+json" is:inline set:html={j} />)}
    <Analytics />
    <slot name="head" />
  </head>
  <body>
    <a class="skip" href="#main">{t(lang).nav.skip}</a>
    <div class="page">
      <div class="page-body">
        {nav && <Nav />}
        <main id="main">
          <slot />
        </main>
        <GoogleSources />
      </div>
      {footer && <Footer />}
    </div>
    {floatingButton && <FloatingButton />}
    <script>
      import '../scripts/alert-widget';
    </script>
  </body>
</html>

<style>
  .page { overflow: clip; }
  /* The footer is "revealed" under the page: the page body sits above it with rounded bottom corners. */
  .page-body {
    position: relative;
    z-index: 2;
    background: var(--color-bg);
    border-bottom-left-radius: var(--radius-large);
    border-bottom-right-radius: var(--radius-large);
  }
  .skip {
    position: absolute;
    top: var(--size-0-5);
    left: var(--size-0-5);
    z-index: 1001;
    padding: var(--size-0-5) var(--size-1);
    border-radius: var(--radius-small);
    background: var(--white);
    color: var(--color-text);
    box-shadow: var(--shadow-large);
  }
  .skip:not(:focus) { clip-path: inset(50%); }
</style>
